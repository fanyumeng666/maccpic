! M1: collisionless sheath formation. Case 1 plasma, no gas, no drive, both
! electrodes grounded; 10 us = 136 "periods" of 73.7 ns (ion transit L/2/c_s = 4.3 us)
&ccp1d
  L = 0.067d0, nx = 128
  freq = 13.56d6, V0 = 0d0
  n_gas = 0d0
  n0 = 2.56d14, Te0 = 30000d0, Ti0 = 300d0
  nppc = 512
  steps_per_period = 400
  n_periods = 136
  n_avg = 8
  n_phase = 100
  seed = 12345
  restart = .false., restart_every = 68
  iedf_emax = 100d0, iedf_de = 0.25d0
/
